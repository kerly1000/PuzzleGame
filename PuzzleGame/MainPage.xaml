<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PuzzleGame.MainPage"
    Title="Puzzle Game">

    <Grid Padding="20" RowDefinitions="Auto,Auto,*,Auto, Auto" RowSpacing="15">

        <Label
            Grid.Row="0"
            Text="🧩 Puzzle Game"
            FontSize="32"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Grid.Row="1"
            Text="Choose your puzzle"
            FontSize="20"
            HorizontalOptions="Center" />

        <CollectionView
            x:Name="PuzzleList"
            Grid.Row="2"
            SelectionMode="Single"
            SelectionChanged="Puzzle_Selected">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="20"
                    Spacing="10"
                    VerticalOptions="Center">

                    <Label
                        Text="No puzzles yet"
                        FontSize="18"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Add your first puzzle below!"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Padding="10"
                        Margin="0,5"
                        Stroke="#CCCCCC"
                        StrokeThickness="1">

                        <Grid
                            ColumnDefinitions="110,*"
                            ColumnSpacing="15">

                            <Image
                                Grid.Column="0"
                                Source="{Binding ImagePath}"
                                HeightRequest="100"
                                WidthRequest="100"
                                Aspect="AspectFill" />


                            <VerticalStackLayout
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Spacing="8">            

                                <Label
                                    Text="{Binding Name}"
                                    FontSize="20"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding CreatedAt, StringFormat='Added: {0:dd.MM.yyyy}'}"
                                    FontSize="13"
                                    TextColor="Gray" />

                                <Label
                                    Text="▶ Play puzzle"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#2563EB" />

                                <Button
                                    Text="Delete puzzle"
                                    Clicked="DeletePuzzle_Clicked"
                                    FontSize="12"
                                    Padding="8,4"
                                    HeightRequest="32"
                                    HorizontalOptions="Start"
                                    BackgroundColor="Transparent"
                                    TextColor="Gray"
                                    BorderColor="Transparent"
                                    BorderWidth="0" />

                            </VerticalStackLayout>


                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button
            Grid.Row="3"
            Text="+ Add Puzzle"
            Clicked="AddPuzzle_Clicked" />

        <Button
            Text="View Results"
            Grid.Row="4"
            Clicked="ViewResults_Clicked" />

    </Grid>

</ContentPage>
