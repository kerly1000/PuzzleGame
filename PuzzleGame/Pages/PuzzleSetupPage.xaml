<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PuzzleGame.Pages.PuzzleSetupPage"
    Title="Puzzle Setup">

    <ScrollView>
        <VerticalStackLayout
            Padding="25"
            Spacing="20">

            <Label
                Text="Prepare your puzzle"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Image
                x:Name="SelectedPuzzleImage"
                HeightRequest="220"
                Aspect="AspectFit" />

            <Label
                x:Name="PuzzleNameLabel"
                Text="Selected puzzle"
                FontSize="22"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Choose difficulty:"
                FontSize="18" />

            <Picker
                x:Name="DifficultyPicker"
                Title="Select difficulty">

                <Picker.Items>
                    <x:String>Easy - 3 x 3 pieces</x:String>
                    <x:String>Medium - 4 x 4 pieces</x:String>
                    <x:String>Hard - 5 x 5 pieces</x:String>
                </Picker.Items>

            </Picker>

            <Button
                Text="Start Puzzle"
                Clicked="StartPuzzle_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
